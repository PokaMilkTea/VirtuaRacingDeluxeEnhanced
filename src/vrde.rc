// vrde.exe's Windows resources: the manifest and the version information Explorer shows
#include <winver.h>
#include "version.h"

1 24 "vrde.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VRDE_VERSION_NUMBERS
PRODUCTVERSION  VRDE_VERSION_NUMBERS
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription",  "Virtua Racing Deluxe enhanced front end (non-commercial)"
      VALUE "FileVersion",      VRDE_VERSION
      VALUE "InternalName",     "vrde"
      VALUE "OriginalFilename", "vrde.exe"
      VALUE "ProductName",      "VirtuaRacingDeluxeEnhanced"
      VALUE "ProductVersion",   VRDE_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
